
FROM node:24-alpine

WORKDIR /app

# Copia os arquivos que definem as dependências
COPY package*.json ./

# Instala as dependências de forma reproduzível
RUN npm ci

# Copia o código do frontend
COPY . .

# Porta utilizada pelo Vite
EXPOSE 5173

# Executa o servidor de desenvolvimento
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
